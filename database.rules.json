{
  "rules": {
    ".read": false,
    ".write": false,
    "parking": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email == 'baloyibasani208@gmail.com' || auth.token.sensor == true)"
    },
    "logs": {
      ".read": "auth != null && auth.token.email == 'baloyibasani208@gmail.com'",
      ".write": "auth != null && (auth.token.email == 'baloyibasani208@gmail.com' || auth.token.sensor == true)"
    },
    "staff": {
      ".read": "auth != null && (auth.token.email == 'baloyibasani208@gmail.com' || auth.token.sensor == true)",
      ".write": "auth != null && auth.token.email == 'baloyibasani208@gmail.com'"
    },
    "bookings": {
      ".read": "auth != null && auth.token.email == 'baloyibasani208@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'baloyibasani208@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'baloyibasani208@gmail.com')"
      }
    },
    "bookingLocks": {
      "$slot": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email == 'baloyibasani208@gmail.com' || newData.child('uid').val() == auth.uid || data.child('uid').val() == auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'bookingId', 'bookedAt']) && newData.child('uid').isString() && newData.child('bookingId').isString() && newData.child('bookedAt').isNumber())"
      }
    },
    "bookingByCard": {
      ".read": false,
      ".write": false
    },
    "rfid": {
      "cardID": {
        ".write": "auth != null && auth.token.sensor == true"
      },
      "t": {
        ".write": "auth != null && auth.token.sensor == true"
      }
    }
  }
}